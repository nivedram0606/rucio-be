# Database connection string (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/restaurant_os?schema=public"

# Operator key for private onboarding (min 32 bytes)
ONBOARDING_API_KEY="restaurant-os-dev-loopback-key-2026-min-32-bytes"

# Server network binding
PORT=3000
HOST="0.0.0.0"

# Allowed frontend origin(s) for CORS and CSRF protection (comma-separated)
# In development: defaults to localhost and 127.0.0.1 loopback
# In production: set to your Netlify/custom frontend URL (e.g. https://your-app.netlify.app)
ALLOWED_ORIGIN="http://localhost:5173,http://127.0.0.1:5173"

# Cookie SameSite attribute: Strict (default, best with same-origin / Netlify proxy) or None (for cross-domain)
COOKIE_SAME_SITE="Strict"
